# ── CRM ───────────────────────────────────────────────
CRM_PROVIDER=zoho                      # zoho | hubspot | generic
CRM_BASE_URL=https://www.zohoapis.eu   # https://api.hubapi.com for HubSpot

# ── Voice platform ───────────────────────────────────
VOICE_API_BASE_URL=https://api.elevenlabs.io
VOICE_PHONE_NUMBER_ID=
VOICE_WEBHOOK_SECRET=

# ── Agents (one per campaign) ─────────────────────────
AGENT_MISSED_APPT=
AGENT_RENTAL_DOCS=
AGENT_REMINDER=

# ── Ops ──────────────────────────────────────────────
ALERT_WEBHOOK_URL=
KPI_INGEST_URL=

# ── QA loop ──────────────────────────────────────────
QA_SHEET_ID=
QA_GATEWAY_TOKEN=                      # long random string, e.g. `openssl rand -hex 32`
QA_MODEL=claude-sonnet-5

# Code nodes need env access (self-hosted):
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
