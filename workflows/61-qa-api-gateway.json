    {
      "parameters": {
        "jsCode": "// Apply selected QA findings to the current prompt. Structure-preserving, variable-preserving.\nconst cfg = $('Load config').first().json.qa;\nconst { params } = $('Route request').first().json;\nconst fixes = params.issues.filter(i => i && i.category !== 'settings').map((i, n) =>\n  `${n + 1}. [${i.severity ?? 'issue'}] ${i.root_cause ?? i.evidence ?? ''}\\n   Fix: ${i.fix ?? ''}${i.prompt_patch ? `\\n   Exact text: ${i.prompt_patch}` : ''}`).join('\\n');\nconst system = `You edit system prompts for voice agents. Apply ONLY the listed fixes.\n- Preserve structure, section order, tone and every {{dynamic_variable}} exactly.\n- Do not add new behaviour that no fix asks for. Remove text only if a fix requires it.\n- If the prompt exceeds ~8000 characters, tighten wording without dropping any rule.\n- Write in the prompt's existing language (${params.language}).\nReturn only the full revised prompt. No commentary.`;\nreturn [{ json: { request: { model: cfg.model, max_tokens: 8000, temperature: 0, system,\n  messages: [{ role: 'user', content: `<current_prompt>\\n${params.current_prompt}\\n</current_prompt>\\n\\n<fixes>\\n${fixes || '(none)'}\\n</fixes>` }] } } }];\n"
      },
