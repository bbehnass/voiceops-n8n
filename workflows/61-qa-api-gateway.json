    {
      "parameters": {
        "jsCode": "const agent = $('Route request').first().json.params.agent_id;\nconst num = v => (v === '' || v == null ? null : Number(v));\nconst scores = $('Read scores').all().map(i => i.json).filter(r => r.conversation_id && (!agent || r.agent_id === agent))\n  .map(r => ({ analyzed_at: r.analyzed_at, agent_id: r.agent_id, agent_name: r.agent_name, conversation_id: r.conversation_id,\n    score: num(r.score), llm_avg_ms: num(r.llm_avg_ms), tts_avg_ms: num(r.tts_avg_ms), cost_usd: num(r.cost_usd), issues: num(r.issues) }));\nconst changes = $input.all().map(i => i.json).filter(r => r.agent_id && (!agent || r.agent_id === agent));\nreturn [{ json: { scores, prompt_changes: changes } }];\n"
      },
