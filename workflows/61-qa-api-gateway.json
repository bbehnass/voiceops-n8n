      "parameters": {
        "jsCode": "const res = $input.first().json;\nconst text = (res.content ?? []).filter(b => b.type === 'text').map(b => b.text).join('').trim();\nconst job_id = $('New rewrite job').first().json.job_id;\nreturn [{ json: { job_id, status: text ? 'done' : 'error', finished_at: DateTime.now().toUTC().toISO(),\n  result_json: JSON.stringify(text ? { updated_prompt: text } : { error: res.error?.message ?? 'empty response' }).slice(0, 49000) } }];\n"
