      "parameters": {
        "jsCode": "const row = $input.all().map(i => i.json).find(r => r.job_id === $('Route request').first().json.params.job_id);\nif (!row) return [{ json: { status: 'unknown' } }];\nlet result = null;\nif (row.status === 'done') { try { result = JSON.parse(row.result_json); } catch { result = null; } }\nreturn [{ json: { job_id: row.job_id, kind: row.kind, status: row.status, result } }];\n"
