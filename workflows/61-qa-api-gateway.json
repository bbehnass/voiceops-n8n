      "parameters": {
        "content": "## 🚪 QA API gateway\nOne POST endpoint `{ token, action, params }` for the dashboard.\nProxies the voice platform (keys stay server-side), starts async analysis jobs, serves job status + score history, runs prompt rewrites, logs deploys and client errors.\nStore = Google Sheets tabs: `jobs`, `scores`, `analyzed_calls`, `prompt_changes`, `client_errors`.",
        "width": 520,
        "height": 240,
        "color": 7
      },
