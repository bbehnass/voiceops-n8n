    {
      "parameters": {
        "jsCode": "// Single authenticated endpoint. The browser never holds provider API keys.\nconst cfg = $('Load config').first().json.qa;\nconst body = $('QA API').first().json.body ?? {};\nconst ACTIONS = ['list_agents', 'get_agent', 'list_conversations', 'start_analysis', 'job_status',\n                 'scores', 'rewrite_prompt', 'mark_prompt_deployed', 'log_client_error'];\n\nconst safeEq = (a, b) => typeof a === 'string' && typeof b === 'string' && a.length === b.length && [...a].every((c, i) => c === b[i]);\nif (!cfg.gateway_token || !safeEq(body.token, cfg.gateway_token)) return [{ json: { route: 9, status: 401, error: 'unauthorized' } }];\n\nconst action = body.action;\nconst route = ACTIONS.indexOf(action);\nif (route < 0) return [{ json: { route: 9, status: 400, error: `unknown action \"${action}\"` } }];\n\nconst id = v => (/^[A-Za-z0-9_\\-]{3,100}$/.test(String(v ?? '')) ? String(v) : null);\nconst p = body.params ?? {};\nconst params = {\n  agent_id: id(p.agent_id), job_id: id(p.job_id),\n  days_back: p.days_back, call_limit: p.call_limit, force_reanalyze: p.force_reanalyze === true,\n  conversation_ids: (Array.isArray(p.conversation_ids) ? p.conversation_ids : []).map(id).filter(Boolean).slice(0, 25),\n  current_prompt: typeof p.current_prompt === 'string' ? p.current_prompt.slice(0, 60000) : '',\n  issues: Array.isArray(p.issues) ? p.issues.slice(0, 30) : [],\n  language: typeof p.language === 'string' ? p.language.slice(0, 5) : 'en',\n  note: typeof p.note === 'string' ? p.note.slice(0, 500) : '',\n  error: typeof p.error === 'string' ? p.error.slice(0, 2000) : '',\n};\nconst needsAgent = ['get_agent', 'list_conversations', 'start_analysis', 'mark_prompt_deployed'];\nif (needsAgent.includes(action) && !params.agent_id) return [{ json: { route: 9, status: 400, error: 'agent_id required' } }];\nif (action === 'job_status' && !params.job_id) return [{ json: { route: 9, status: 400, error: 'job_id required' } }];\nreturn [{ json: { route, action, params } }];\n"
      },
