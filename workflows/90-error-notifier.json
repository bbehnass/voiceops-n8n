    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst url = (() => { try { return $env.ALERT_WEBHOOK_URL || ''; } catch { return ''; } })();\nif (!url) return [];\nconst wf = e.workflow?.name ?? 'unknown workflow';\nconst node = e.execution?.lastNodeExecuted ?? '?';\nconst msg = e.execution?.error?.message ?? 'Unknown error';\nreturn [{ json: { url, payload: { text: `:rotating_light: *${wf}* failed at *${node}*\\n>${msg}\\n${e.execution?.url ?? ''}` } } }];\n"
      },
      "id": "48068268-c649-5398-9cb1-50293ccb4611",
