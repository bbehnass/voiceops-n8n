          "mode": "id",
          "value": "vopsDispatcher00"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "183a2fb6-fabf-57eb-bacc-afcec0ccaed0",
      "name": "Dispatch touch",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1540,
