        "amount": "={{ $json.delay }}",
        "unit": "minutes"
      },
      "id": "f23d5fa9-1804-5252-be27-cdb0ff27dbf9",
      "name": "Retry delay",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        660,
        0
      ],
      "webhookId": "08d99eb1-035b-51a5-8af4-1091318bf118"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { op: 'search_activities', payload: { run_name: $('Plan retry').first().json.run_name } } }];\n"
      },
      "id": "1e810e2a-2d39-592c-8484-15456cc7617b",
      "name": "Search this run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "vopsCrmAdapter00"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "71651486-b3f4-5625-9f19-d57afb891c45",
      "name": "Fetch outcomes",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Retry only people whose LATEST attempt in this run ended in a retryable outcome.\nconst plan = $('Plan retry').first().json;\nconst retryable = new Set(plan.campaign.retry.retry_on.map(s => s.toLowerCase()));\nconst latest = new Map();\nfor (const a of $input.first().json.activities ?? []) {\n  if (a.run_name !== plan.run_name) continue;\n  const prev = latest.get(String(a.contact_id));\n  if (!prev || String(a.started_at ?? '') > String(prev.started_at ?? '')) latest.set(String(a.contact_id), a);\n}\nconst ids = new Set([...latest.entries()].filter(([, a]) => retryable.has(String(a.outcome ?? '').toLowerCase())).map(([id]) => id));\nconst recipients = plan.recipients.filter(r => ids.has(String(r.id)));\nif (!recipients.length) return [];\nreturn [{ json: {\n  campaign_key: plan.campaign_key,\n  run_name: `${plan.base_run_name} (Retry ${plan.attempt})`,\n  attempt: plan.attempt + 1,\n  skip_ab: true,                 // arms were assigned on the first attempt\n  recipients,                    // eligibility is re-checked again by the dispatcher\n} }];\n"
      },
      "id": "d1ed560e-bd62-579f-8216-a748be947f91",
      "name": "Select retry recipients",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        0
      ]
    },
