{
  "name": "VoiceOps · 41 · Retry Scheduler",
  "nodes": [
    {
      "parameters": {
        "content": "## ↩️ Retry scheduler\nWaits `retry.delay_minutes`, reads this run's outcomes from the CRM, and re-dispatches only people whose latest attempt was voicemail / no answer / failed.\nBounded by `retry.max_retries`. Goes back through the dispatcher, so eligibility is re-checked.",
        "width": 440,
        "height": 210,
        "color": 7
      },
      "id": "f313282c-58df-5e6a-b4cc-8cd1bf2ba19d",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -330
      ]
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "ad7d3709-ad7d-5061-817f-2618c1483ac0",
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "vopsConfig000000"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "bc05a9e3-afb7-5f23-9976-e0afc7776757",
      "name": "Load config",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        220,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Load config').first().json;\nconst x = $('Start').first().json;\nconst c = cfg.campaigns[x.campaign_key];\nreturn [{ json: { ...x, campaign: c, base_run_name: x.run_name.replace(/ \\(Retry \\d+\\)$/, ''), delay: c.retry.delay_minutes ?? 180 } }];\n"
      },
      "id": "557079c8-fffc-541e-8ad2-a9974b8cda8b",
      "name": "Plan retry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
