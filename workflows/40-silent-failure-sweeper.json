{
  "name": "VoiceOps · 40 · Silent-failure Sweeper",
  "nodes": [
    {
      "parameters": {
        "content": "## 🧹 Silent-failure sweeper\nVoice platforms don't always send a post-call webhook (blocked numbers, carrier rejects).\nAfter the batch **really** finishes (polled, capped), anyone dialled without an activity for this run gets a `Failed` record — nobody disappears from reporting.\nThen decides whether to schedule a retry.",
        "width": 460,
        "height": 230,
        "color": 7
      },
      "id": "cbe79891-5cc1-53bb-801d-a5f502abe9ef",
      "name": "About",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -360
      ]
    },
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "30e54944-f982-5645-956a-256de86653d8",
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "vopsConfig000000"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "164942f4-977c-5d0a-b8b7-f68190b4016b",
      "name": "Load config",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        220,
        0
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Load config').first().json;\nconst x = $('Start').first().json;\nreturn [{ json: { ...x, campaign: cfg.campaigns[x.campaign_key], delay: cfg.safety_net.initial_delay_minutes } }];\n"
      },
      "id": "1a1fcd61-be26-5f48-bfc2-ae6197843204",
      "name": "Plan sweep",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "amount": "={{ $json.delay }}",
        "unit": "minutes"
      },
      "id": "6ceabc1f-5522-5d68-a5de-88eb69ab9bf2",
      "name": "Initial delay",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        660,
        0
      ],
      "webhookId": "a28a09e9-12d9-5851-b12c-d618fe965255"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Load config').first().json.voice.base_url }}/v1/convai/batch-calling/{{ $('Plan sweep').first().json.batch_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "209153f6-4205-56cc-96ed-5dd3ce69ab37",
      "name": "Get batch status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Wait for the batch to actually finish dialling instead of trusting a fixed timer.\nconst cfg = $('Load config').first().json.safety_net;\nconst status = String($input.first().json.status ?? 'unknown').toLowerCase();\nconst finished = ['completed', 'failed', 'cancelled'].includes(status);\nconst exhausted = $runIndex >= cfg.max_polls;\nreturn [{ json: { status, finished: finished || exhausted, forced: !finished && exhausted, polls: $runIndex + 1 } }];\n"
      },
      "id": "5eed15ab-f077-5b56-9835-1176a59dd607",
      "name": "Batch finished?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "9f7b8ea7-90eb-5366-b0aa-a140e85a0c21",
              "leftValue": "={{ $json.finished }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "84b134d3-bfca-5388-b2e2-82d3f4271649",
      "name": "Finished",
