        "amount": "={{ $('Load config').first().json.safety_net.grace_minutes }}",
        "unit": "minutes"
      },
      "id": "bc6961d4-37b5-5985-835f-f5118ea845d5",
      "name": "Grace period",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
