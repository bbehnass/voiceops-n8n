        1540,
        -20
      ],
      "webhookId": "a5e7c586-4feb-521d-a294-57eab36a4d77"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { op: 'search_activities', payload: { run_name: $('Plan sweep').first().json.run_name } } }];\n"
      },
      "id": "63e68c01-32cf-523c-99e2-4b646d58ec6f",
      "name": "Search this run",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        -20
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "vopsCrmAdapter00"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "bcd3cc5c-b5a5-508b-80b2-75e6e0e9a978",
      "name": "Fetch logged activities",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        1980,
        -20
      ]
    },
    {
      "parameters": {
        "jsCode": "// Everyone we dialled in THIS run who has no activity for THIS run is a silent failure\n// (blocked number, carrier reject, webhook never sent…). Scope by run — a call record\n// from another campaign must not hide a failure in this one.\nconst plan = $('Plan sweep').first().json;\nconst logged = new Set(($input.first().json.activities ?? [])\n  .filter(a => a.run_name === plan.run_name).map(a => String(a.contact_id)));\nconst missing = plan.recipients.filter(r => !logged.has(String(r.id)));\nreturn [{ json: { run_name: plan.run_name, dialled: plan.recipients.length, logged: logged.size, missing } }];\n"
      },
      "id": "9edfc838-d458-5ad4-b5e7-97d924e85cb0",
      "name": "Find silent failures",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        -20
      ]
    },
    {
      "parameters": {
        "jsCode": "const plan = $('Plan sweep').first().json;\nconst cfg = $('Load config').first().json;\nconst { missing } = $input.first().json;\nconst label = cfg.defaults.outcome_labels.failed;\nconst note = `AI call outcome: ${label}\\n\\nSummary: no post-call event received from the voice platform (batch ${plan.batch_id}).`;\nreturn missing.map(r => ({ json: { op: 'log_activity', payload: {\n  contact_id: r.id, campaign_key: plan.campaign_key, run_name: plan.run_name,\n  outcome_label: label, summary: 'No post-call event received', note,\n  started_at: DateTime.now().minus({ minutes: plan.delay }).toUTC().toISO({ suppressMilliseconds: true }), duration_secs: 0,\n} } }));\n"
      },
      "id": "f6b1135a-ef26-5b4a-84d7-299d57c25f45",
      "name": "Build failure records",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        -160
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "vopsCrmAdapter00"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": true
        }
      },
      "id": "76c956f4-298d-5a8f-8b13-461c4bd5fb98",
      "name": "Write failure records",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2640,
        -160
      ]
    },
    {
      "parameters": {
        "jsCode": "const plan = $('Plan sweep').first().json;\nconst r = plan.campaign.retry;\nif (!r?.enabled || plan.attempt > (r.max_retries ?? 1)) return [];\nreturn [{ json: { campaign_key: plan.campaign_key, run_name: plan.run_name, attempt: plan.attempt, recipients: plan.recipients } }];\n"
      },
      "id": "8b36f480-160c-5ccd-a3f3-627afb3bd383",
      "name": "Retry decision",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2420,
        100
      ]
    },
    {
      "parameters": {
        "source": "database",
        "workflowId": {
          "__rl": true,
          "mode": "id",
          "value": "vopsRetry0000000"
        },
        "mode": "once",
        "options": {
          "waitForSubWorkflow": false
        }
      },
      "id": "8f220838-cbb6-567e-8721-6533d28f2f61",
      "name": "Schedule retry",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        2640,
        100
      ]
    }
